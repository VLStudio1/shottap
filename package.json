{
  "name": "shottap",
  "version": "0.5.1",
  "description": "Keyboard-first screenshots and screen recording for Windows with cleanup shortcuts.",
  "author": "VeraLayer Studio LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VLStudio1/shottap.git"
  },
  "homepage": "https://github.com/VLStudio1/shottap#readme",
  "bugs": {
    "url": "https://github.com/VLStudio1/shottap/issues"
  },
  "keywords": [
    "screenshot",
    "screen-capture",
    "screen-recorder",
    "windows",
    "hotkeys",
    "clipboard",
    "electron"
  ],
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "selftest": "node test/run-selftest.js",
    "docs:screenshots": "node test/run-docs-screenshots.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.veralayerstudio.shottap",
    "productName": "ShotTap",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShotTap",
      "artifactName": "ShotTap-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ShotTap-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {}
}
